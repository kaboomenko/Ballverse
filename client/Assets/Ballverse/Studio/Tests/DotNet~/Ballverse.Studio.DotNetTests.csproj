<Project Sdk="Microsoft.NET.Sdk">
  <!--
    .NET harness of Ballverse.Studio (no Unity). Compiles the pure-C# parts of the studio runtime together with the Media
    sources it drives (Api, Common, Internal, Fake) and the Media harness's Unity stand-ins, and runs xunit tests:
    UnityFileStore against the Core IFileStore contract tests, clip library, PCM file source, offline mix, and the export
    pipeline end to end on the fake media backend (segments, join, verification, cancel, pause, resume, encoder retry, gate).
    The folder ends in "~" so Unity ignores it. Usage: ./run.sh
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Ballverse.Studio.DotNetTests</AssemblyName>
    <RootNamespace>Ballverse.Studio.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unity stand-ins and the Media test pump (main-thread synchronization context) from the Media harness. -->
    <Compile Include="../../../Media/Tests/DotNet~/UnityStubs.cs" />
    <Compile Include="../../../Media/Tests/EditMode/TestSupport.cs" />
    <Compile Include="../../../Media/Api/*.cs;../../../Media/Common/*.cs;../../../Media/Internal/*.cs;../../../Media/Fake/*.cs" />
    <Compile Include="../../../App/Platform/*.cs" />
    <!-- Pure-C# parts of the studio runtime. -->
    <Compile Include="../../Storage/*.cs" />
    <Compile Include="../../Clips/ClipLibrary.cs" />
    <Compile Include="../../Audio/PcmFileSource.cs;../../Audio/StudioAudioMixer.cs" />
    <Compile Include="../../Export/ExportContracts.cs;../../Export/ExportPipeline.cs;../../Export/StudioExportAudio.cs" />
    <Compile Include="Tests/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../../../core-tests/Ballverse.Core.Tests/Ballverse.Core.Tests.csproj" />
    <ProjectReference Include="../../../../../../core-tests/Ballverse.Core/Ballverse.Core.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
