/* Colour themes (spec §4.4): dark by default, light, plus the contrast modifier (spec §4.8).
   One accent ("electric" blue-violet, brand book pending, question В16) for the main actions. */

.bv-theme-dark {
    --color-bg: #0B0D14;
    --color-surface: #161924;
    --color-surface-2: #1F2331;
    --color-surface-3: #2A2F40;
    --color-text: #FFFFFF;
    --color-text-2: rgba(235, 240, 255, 0.72);
    --color-text-3: rgba(235, 240, 255, 0.48);
    --color-accent: #6C5CFF;
    --color-accent-pressed: #5546E6;
    --color-accent-2: #3D8BFF;
    --color-on-accent: #FFFFFF;
    --color-separator: rgba(255, 255, 255, 0.08);
    --color-control: rgba(255, 255, 255, 0.12);
    --color-control-pressed: rgba(255, 255, 255, 0.2);
    --color-danger: #FF4D5E;
    --color-success: #2FD27A;
    --color-warning: #FFB020;
    --color-accent-text: #9B91FF;
    --color-danger-text: #FF4D5E;
    --color-success-text: #2FD27A;
    --color-warning-text: #FFB020;
    --color-scrim: #000000;
    --color-media-chip: rgba(0, 0, 0, 0.45);
    --glass-frosted: rgba(22, 25, 36, 0.93);
    --glass-solid: rgba(22, 25, 36, 0.92);
    --glass-border: rgba(255, 255, 255, 0.14);
    --glass-highlight: rgba(255, 255, 255, 0.34);
}

.bv-theme-light {
    --color-bg: #F2F3F7;
    --color-surface: #FFFFFF;
    --color-surface-2: #E9EBF1;
    --color-surface-3: #DCDFE8;
    --color-text: #14161A;
    --color-text-2: rgba(20, 22, 26, 0.7);
    --color-text-3: rgba(20, 22, 26, 0.48);
    --color-accent: #5A4BFF;
    --color-accent-pressed: #4638E0;
    --color-accent-2: #2F7BFF;
    --color-on-accent: #FFFFFF;
    --color-separator: rgba(0, 0, 0, 0.08);
    --color-control: rgba(0, 0, 0, 0.07);
    --color-control-pressed: rgba(0, 0, 0, 0.14);
    --color-danger: #E5384A;
    --color-success: #19A75C;
    --color-warning: #C77A00;
    --color-accent-text: #4B3CF0;
    --color-danger-text: #C4283A;
    --color-success-text: #127A43;
    --color-warning-text: #8F5A00;
    --color-scrim: #000000;
    --color-media-chip: rgba(0, 0, 0, 0.45);
    --glass-frosted: rgba(250, 250, 252, 0.84);
    --glass-solid: rgba(250, 250, 252, 0.92);
    --glass-border: rgba(0, 0, 0, 0.08);
    --glass-highlight: rgba(255, 255, 255, 0.9);
}

/* Text colours: --color-text, -2, -3 and the *-text tokens (accent, danger, success, warning used as text or icon
   colour; the plain --color-accent / --color-warning ... are fills). Outside glass the *-text tokens reach 4.5:1 on the
   background and surfaces.
   Text on glass (spec §4.5: WCAG AA 4.5:1 in the worst case): inside .bv-glass every text colour is opaque and at least
   as strong as the weakest of them, and the adaptive tint is computed for that weakest one, so all of them keep 4.5:1
   however bright the backdrop is (GlassTextPalette in Model/Glass; ShellStaticChecksTests keeps these values in sync
   and bans fill colours as text colours).
   Control fills under labels (chips, secondary buttons, segmented controls, text fields, selected rows) are opaque
   inside .bv-glass: a translucent fill drawn over the tinted glass would lift it above the compose-pass bound (UI
   Toolkit blends in linear space here, so 12% white alone adds 0.12 luminance), so on glass the labels stand on a
   solid colour that keeps 4.5:1 with every glass text colour. Because the opaque control fill can equal
   --color-surface-3 (dark glass: both #2A2F40), a selected segment or row is never marked by its fill alone: it has a
   --color-text outline / leading bar with >= 3:1 against the track and the glass (Components.uss, QaRound5Tests).
   Frosted glass (no backdrop source, e.g. the tab bar over the gallery) has no adaptive tint: --glass-frosted is opaque
   enough that the weakest glass text keeps 4.5:1 over white content (dark theme) or black content (light theme), in
   linear and in gamma blending (GlassTextPalette.MinFrostedAlpha, QaRound3Tests). */
.bv-theme-dark .bv-glass {
    --color-control: #2A2F40;
    --color-control-pressed: #363C50;
    --color-text-2: #DCE1ED;
    --color-text-3: #C4CAD8;
    --color-accent-text: #D2CCFF;
    --color-danger-text: #FFB8BF;
    --color-success-text: #9DF0C2;
    --color-warning-text: #FFD27A;
}

.bv-theme-light .bv-glass {
    --color-control: #E3E6ED;
    --color-control-pressed: #D2D6E0;
    --color-text-2: #3A3F48;
    --color-text-3: #525965;
    --color-accent-text: #3B2FC9;
    --color-danger-text: #A01828;
    --color-success-text: #0A5E31;
    --color-warning-text: #6E4300;
}

/* Contrast theme: stronger secondary text and separators, denser frosted glass. */
.bv-theme-dark.bv-contrast {
    --color-text-2: rgba(255, 255, 255, 0.9);
    --color-text-3: rgba(255, 255, 255, 0.75);
    --color-separator: rgba(255, 255, 255, 0.3);
    --color-control: rgba(255, 255, 255, 0.22);
    --glass-frosted: rgba(12, 14, 20, 0.94);
    --glass-border: rgba(255, 255, 255, 0.5);
}

.bv-theme-light.bv-contrast {
    --color-text-2: rgba(0, 0, 0, 0.88);
    --color-text-3: rgba(0, 0, 0, 0.72);
    --color-separator: rgba(0, 0, 0, 0.3);
    --color-control: rgba(0, 0, 0, 0.16);
    --glass-frosted: rgba(255, 255, 255, 0.96);
    --glass-border: rgba(0, 0, 0, 0.45);
}

/* Contrast theme on glass: stronger (still opaque) control fills; the glass text colours stay as above. */
.bv-theme-dark.bv-contrast .bv-glass {
    --color-control: #3A4157;
    --color-control-pressed: #474F68;
}

.bv-theme-light.bv-contrast .bv-glass {
    --color-control: #D6DAE3;
    --color-control-pressed: #CDD1DB;
}
