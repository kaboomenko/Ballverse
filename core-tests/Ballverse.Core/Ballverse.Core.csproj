<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the Unity Core sources (client/Assets/Ballverse/Core) outside Unity so they can be tested with `dotnet test`.
    Mirrors Unity's constraints: netstandard2.1, C# 9, no UnityEngine, Newtonsoft.Json 13.0.2 (com.unity.nuget.newtonsoft-json 3.2.1).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Ballverse.Core</AssemblyName>
    <RootNamespace>Ballverse.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../client/Assets/Ballverse/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="../BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ballverse.Core.Tests" />
  </ItemGroup>
</Project>
