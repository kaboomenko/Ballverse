<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="app-root" class="bv-app bv-fill">
        <ui:VisualElement name="screen-layer" class="bv-layer bv-fill" />
        <ui:VisualElement name="tabbar-host" class="bv-tabbar-host" picking-mode="Ignore">
            <ui:VisualElement name="tabbar" class="bv-tabbar bv-glass">
                <ui:VisualElement name="tab-modes" class="bv-tabbar__item">
                    <ui:VisualElement class="bv-icon icon--modes bv-tabbar__icon" />
                    <ui:Label text="#tab.modes" class="bv-tabbar__label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="tab-projects" class="bv-tabbar__item">
                    <ui:VisualElement class="bv-icon icon--projects bv-tabbar__icon" />
                    <ui:Label text="#tab.projects" class="bv-tabbar__label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="tab-shop" class="bv-tabbar__item">
                    <ui:VisualElement class="bv-icon icon--shop bv-tabbar__icon" />
                    <ui:Label text="#tab.shop" class="bv-tabbar__label" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="bv-safe-bottom" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="sheet-layer" class="bv-layer bv-fill" picking-mode="Ignore" />
        <ui:VisualElement name="dialog-layer" class="bv-layer bv-fill" picking-mode="Ignore" />
        <ui:VisualElement name="toast-layer" class="bv-layer bv-fill bv-toast-layer" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
